<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WonderfulAdminApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WonderfulAdmin"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main 3x3 Grid Dashboard matching Image 2 -->
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 9 Sub-screens -->
        <activity android:name=".presentation.dashboard.DashboardActivity" android:exported="false" android:label="Dashboard" />
        <activity android:name=".presentation.products.ProductsActivity" android:exported="false" android:label="Products" />
        <activity android:name=".presentation.categories.CategoriesActivity" android:exported="false" android:label="Categories" />
        <activity android:name=".presentation.orders.OrdersActivity" android:exported="false" android:label="Orders" />
        <activity android:name=".presentation.customers.CustomersActivity" android:exported="false" android:label="Customers" />
        <activity android:name=".presentation.coupons.CouponsActivity" android:exported="false" android:label="Coupons" />
        <activity android:name=".presentation.inventory.InventoryActivity" android:exported="false" android:label="Stock / Inventory" />
        <activity android:name=".presentation.reports.ReportsActivity" android:exported="false" android:label="Reports" />
        <activity android:name=".presentation.settings.SettingsActivity" android:exported="false" android:label="Settings" />

    </application>

</manifest>
