atim.openstreetmap.org; report-uri /api/csp-report.php; report-to csp-endpoint"
    <IfModule mod_setenvif.c>
        SetEnvIfNoCase Host "^staging\.shopademia\.store$" WC_STAGING_HOST
        Header always set X-WC-Environment "staging" env=WC_STAGING_HOST
        Header always set X-Robots-Tag "noindex, nofollow" env=WC_STAGING_HOST
        SetEnvIf Request_URI "^/api/" NO_CACHE
        SetEnvIf Request_URI "^/$|^/(?!admin(?:/|\.html|$)|api(?:/|$)).*\.html$|^/render-storefront\.php$" TRACKING_PUBLIC=1
        SetEnvIf REDIRECT_STATUS "^404$" TRACKING_PUBLIC=1
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE
        Header always set CDN-Cache-Control "no-store" env=NO_CACHE
        Header always set Surrogate-Control "no-store" env=NO_CACHE
        Header always set Pragma "no-cache" env=NO_CACHE
        Header always set Expires "0" env=NO_CACHE
        <If "reqenv('TRACKING_PUBLIC') == '1'">
            Header always unset Content-Security-Policy
            Header always unset Content-Security-Policy-Report-Only
            Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' https: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https: 'unsafe-inline'; script-src-attr 'none'; connect-src 'self' https://nominatim.openstreetmap.org https:; frame-src 'self' https://www.googletagmanager.com; upgrade-insecure-requests"
        </If>
    </IfModule>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
